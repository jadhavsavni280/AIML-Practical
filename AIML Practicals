facts = {
    "fever",
    "cough",
    "body_pain"
}
rules = [
    (["fever", "cough"], "flu"),
    (["flu", "body_pain"], "viral_infection"),
    (["viral_infection"], "take_rest"),
    (["viral_infection", "fever"], "consult_doctor")
]
def forward_chaining(facts, rules):
    known_facts = set(facts)

    print("\n===== FORWARD CHAINING =====")
    print("Initial Facts:", known_facts)

    while True:
        new_fact = False

        for conditions, conclusion in rules:
            if all(condition in known_facts for condition in conditions):
                if conclusion not in known_facts:
                    known_facts.add(conclusion)
                    print("Rule Fired:", conditions, "->", conclusion)
                    new_fact = True

        if not new_fact:
            break

    print("Final Facts:", known_facts)
    return known_facts
def backward_chaining(goal, facts, rules, visited=None):
    if visited is None:
        visited = set()
    if goal in facts:
        print("Fact found:", goal)
        return True
    if goal in visited:
        return False

    visited.add(goal)
    print("Trying to prove:", goal)

    for conditions, conclusion in rules:
        if conclusion == goal:
            print("Checking Rule:", conditions, "->", conclusion)

            for condition in conditions:
                if not backward_chaining(condition, facts, rules, visited):
                    return False

            print("Goal proved:", goal)
            return True

    print("Cannot prove:", goal)
    return False
