from collections import deque
import time
graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F', 'G'],
    'D': ['H', 'I'],
    'E': ['J'],
    'F': [],
    'G': [],
    'H': [],
    'I': [],
    'J': []
}
def bfs(graph, start, goal):
    queue = deque()
    queue.append((start, [start]))
    visited = set()
    explored = []
    while queue:
        current, path = queue.popleft()
        if current in visited:
            continue
        visited.add(current)
        explored.append(current)
        if current == goal:
            return path, explored
        for neighbour in graph[current]:
            if neighbour not in visited:
                queue.append((neighbour, path + [neighbour]))
    return None, explored
def dfs(graph, start, goal):
    stack = []
    stack.append((start, [start]))
    visited = set()
    explored = []
    while stack:
        current, path = stack.pop()
        if current in visited:
            continue
        visited.add(current)
        explored.append(current)
        if current == goal:
            return path, explored
        for neighbour in reversed(graph[current]):
            if neighbour not in visited:
                stack.append((neighbour, path + [neighbour]))
    return None, explored
start = 'A'
goal = 'J'
start_time = time.perf_counter()
bfs_path, bfs_explored = bfs(graph, start, goal)
bfs_time = time.perf_counter() - start_time
start_time = time.perf_counter()
dfs_path, dfs_explored = dfs(graph, start, goal)
dfs_time = time.perf_counter() - start_time
print("\n===== BFS RESULT =====")
print("Traversal:", " -> ".join(bfs_explored))
print("Path:", " -> ".join(bfs_path))
print("Path Length:", len(bfs_path) - 1)
